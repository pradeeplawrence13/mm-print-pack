<script>
const STORE='mm_print_pack_full_app_v1';
const defaults={transactions:[],customers:[],suppliers:[],quotations:[],invoices:[],payments:[]};
let db=loadDB();
function loadDB(){try{return {...defaults,...JSON.parse(localStorage.getItem(STORE)||'{}')}}catch(e){return {...defaults}}}
function persist(){localStorage.setItem(STORE,JSON.stringify(db));renderAll()}
function uid(prefix){return prefix+'-'+Date.now().toString().slice(-8)+'-'+Math.floor(Math.random()*90+10)}
function money(n){return new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',minimumFractionDigits:2,maximumFractionDigits:2}).format(Number(n)||0)}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2400)}
function openModal(id){document.getElementById(id).classList.add('open')}
function closeModal(id){document.getElementById(id).classList.remove('open')}
const pageTitles={dashboard:'Business Overview',customers:'Customer Management',suppliers:'Supplier Management',quotations:'Quotation Management',invoices:'Invoice Management',income:'Income Management',expenses:'Expense Management',payments:'Payment Tracking',transactions:'Transaction Register',reports:'Reports & Analytics',settings:'Business Settings'};
function showPage(id){document.querySelectorAll('.page').forEach(x=>x.classList.toggle('active',x.id===id));document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('active',x.dataset.page===id));document.getElementById('pageTitle').textContent=pageTitles[id]||'Dashboard';document.getElementById('crumbPage').textContent=id.toUpperCase();renderAll()}
document.querySelectorAll('.nav button').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.page)));
function sum(arr,fn){return arr.reduce((a,x)=>a+fn(x),0)}
function totals(){const inc=sum(db.transactions.filter(x=>x.type==='income'),x=>x.amount),exp=sum(db.transactions.filter(x=>x.type==='expense'),x=>x.amount);return {inc,exp,net:inc-exp,receivable:sum(db.invoices,x=>Math.max(0,x.total-x.received)),payable:0,quotes:sum(db.quotations,x=>x.total),invoices:sum(db.invoices,x=>x.total)}}
function renderDashboard(){
 const t=totals();[['dashIncome',t.inc],['dashExpense',t.exp],['dashNet',t.net],['dashReceivable',t.receivable],['dashQuote',t.quotes],['dashInvoice',t.invoices],['dashPayable',t.payable]].forEach(([id,v])=>document.getElementById(id).textContent=money(v));
 document.getElementById('dashCustomers').textContent=db.customers.length;
 const latest=[...db.transactions].sort((a,b)=>b.date.localeCompare(a.date)).slice(0,6);
 document.getElementById('recentTransactions').innerHTML=latest.map(x=>`<div class="list-row"><div><div class="row-title">${esc(x.category)}</div><div class="row-sub">${esc(x.date)} · ${esc(x.party||x.notes||x.mode)}</div></div><div class="amount ${x.type==='income'?'positive':'negative'}">${x.type==='income'?'+':'−'}${money(x.amount)}</div></div>`).join('')||'<div class="empty">No transactions yet. Add an income or expense entry.</div>';
 const groups={};db.transactions.filter(x=>x.type==='expense').forEach(x=>groups[x.category]=(groups[x.category]||0)+x.amount);
 const sorted=Object.entries(groups).sort((a,b)=>b[1]-a[1]).slice(0,6),max=sorted[0]?.[1]||1;
 document.getElementById('expenseBreakdown').innerHTML=sorted.map(([k,v])=>`<div class="bar-item"><div class="bar-caption"><span>${esc(k)}</span><b>${money(v)}</b></div><div class="bar-track"><div class="bar-fill" style="width:${v/max*100}%"></div></div></div>`).join('')||'<div class="empty">Expense categories will appear here after entries are saved.</div>';
}
const incomeCats=['Customer Invoice Payment','Advance Payment','Box Manufacturing','Die Cutting Charges','Folding Charges','Printing Charges','Other Business Income','Other Sources'];
const expenseCats=['Salary','Labour Payment','Designer Payment','Printing Payment','Paper / Raw Material','Duplex Board / Kraft Paper','Ink & Consumables','Lamination Materials','Gum & Adhesives','Machinery Maintenance','Machine Spare Parts','Electricity','Water','Rent','Transportation','Loading / Unloading','Office Expense','Internet / Mobile','Bank Charges','Cleaning','Miscellaneous'];
function updateEntryCats(){const type=document.getElementById('entryType').value;document.getElementById('entryTitle').textContent=type==='income'?'Record Income':'Record Expense';document.getElementById('entryCategory').innerHTML=(type==='income'?incomeCats:expenseCats).map(x=>`<option>${esc(x)}</option>`).join('')}
function openEntry(type){document.getElementById('entryForm').reset();document.getElementById('entryType').value=type;document.getElementById('entryDate').value=new Date().toISOString().slice(0,10);updateEntryCats();openModal('entryModal')}
document.getElementById('entryType').addEventListener('change',updateEntryCats);
document.getElementById('entryForm').addEventListener('submit',e=>{e.preventDefault();const x={id:uid('TX'),type:document.getElementById('entryType').value,date:document.getElementById('entryDate').value,category:document.getElementById('entryCategory').value,amount:Number(document.getElementById('entryAmount').value),mode:document.getElementById('entryMode').value,party:document.getElementById('entryParty').value,reference:document.getElementById('entryReference').value,owner:document.getElementById('entryOwner').value,notes:document.getElementById('entryNotes').value};if(!(x.amount>0))return toast('Enter an amount greater than zero.');db.transactions.push(x);persist();closeModal('entryModal');toast('Transaction saved successfully.')});
function renderEntries(type){const q=(document.getElementById(type+'Search')?.value||'').toLowerCase(),arr=db.transactions.filter(x=>x.type===type&&[x.category,x.party,x.notes,x.mode].join(' ').toLowerCase().includes(q)).sort((a,b)=>b.date.localeCompare(a.date));const total=sum(arr,x=>x.amount);document.getElementById(type+'PageTotal').textContent=money(total);document.getElementById(type+'PageCount').textContent=arr.length;const id=type==='income'?'incomeRows':'expenseRows';document.getElementById(id).innerHTML=arr.map(x=>`<tr><td>${esc(x.date)}</td><td>${esc(x.category)}</td><td>${esc(x.party||'—')}</td><td>${esc(x.mode)}</td><td>${esc(x.notes||'—')}</td><td><b>${money(x.amount)}</b></td><td><button class="btn small danger" onclick="deleteTransaction('${x.id}')">Delete</button></td></tr>`).join('')||`<tr><td colspan="7" class="empty">No ${type} entries found.</td></tr>`}
function renderTransactions(){const q=(document.getElementById('transactionSearch')?.value||'').toLowerCase(),f=document.getElementById('transactionFilter')?.value||'',arr=db.transactions.filter(x=>(!f||x.type===f)&&[x.category,x.party,x.notes,x.mode,x.reference].join(' ').toLowerCase().includes(q)).sort((a,b)=>b.date.localeCompare(a.date));document.getElementById('transactionRows').innerHTML=arr.map(x=>`<tr><td>${esc(x.date)}</td><td><span class="pill ${x.type}">${x.type==='income'?'Income':'Expense'}</span></td><td>${esc(x.category)}</td><td>${esc(x.party||'—')}</td><td>${esc(x.mode)}</td><td>${esc(x.reference||'—')}</td><td><b>${money(x.amount)}</b></td><td><button class="btn small danger" onclick="deleteTransaction('${x.id}')">Delete</button></td></tr>`).join('')||'<tr><td colspan="8" class="empty">No transactions found.</td></tr>'}
function deleteTransaction(id){if(!confirm('Delete this prototype transaction?'))return;db.transactions=db.transactions.filter(x=>x.id!==id);persist();toast('Transaction deleted.')}
function openCustomer(){document.getElementById('customerForm').reset();openModal('customerModal')}
document.getElementById('customerForm').addEventListener('submit',e=>{e.preventDefault();db.customers.push({id:uid('CUS'),name:custName.value,contact:custContact.value,mobile:custMobile.value,whatsapp:custWhatsapp.value,email:custEmail.value,gst:custGst.value,address:custAddress.value,notes:custNotes.value});persist();closeModal('customerModal');toast('Customer saved.')});
function renderCustomers(){const q=(document.getElementById('customerSearch')?.value||'').toLowerCase(),arr=db.customers.filter(x=>[x.name,x.contact,x.mobile,x.gst,x.address].join(' ').toLowerCase().includes(q));document.getElementById('customerRows').innerHTML=arr.map(x=>`<tr><td><strong>${esc(x.name)}</strong></td><td>${esc(x.contact||'—')}</td><td>${esc(x.mobile)}</td><td>${esc(x.gst||'—')}</td><td>${esc(x.address||'—')}</td><td><button class="btn small danger" onclick="deleteCustomer('${x.id}')">Delete</button></td></tr>`).join('')||'<tr><td colspan="6" class="empty">No customers saved. Add your first customer.</td></tr>'}
function deleteCustomer(id){if(!confirm('Delete this customer?'))return;db.customers=db.customers.filter(x=>x.id!==id);persist()}
function openSupplier(){document.getElementById('supplierForm').reset();openModal('supplierModal')}
document.getElementById('supplierForm').addEventListener('submit',e=>{e.preventDefault();db.suppliers.push({id:uid('SUP'),name:supName.value,category:supCategory.value,contact:supContact.value,mobile:supMobile.value,address:supAddress.value});persist();closeModal('supplierModal');toast('Supplier saved.')});
function renderSuppliers(){const q=(document.getElementById('supplierSearch')?.value||'').toLowerCase(),arr=db.suppliers.filter(x=>[x.name,x.category,x.contact,x.mobile,x.address].join(' ').toLowerCase().includes(q));document.getElementById('supplierRows').innerHTML=arr.map(x=>`<tr><td><b>${esc(x.name)}</b></td><td>${esc(x.category)}</td><td>${esc(x.contact||'—')}</td><td>${esc(x.mobile||'—')}</td><td>${esc(x.address||'—')}</td><td><button class="btn small danger" onclick="deleteSupplier('${x.id}')">Delete</button></td></tr>`).join('')||'<tr><td colspan="6" class="empty">No suppliers saved.</td></tr>'}
function deleteSupplier(id){if(!confirm('Delete this supplier?'))return;db.suppliers=db.suppliers.filter(x=>x.id!==id);persist()}
function nextNumber(type){const a=type==='quotation'?db.quotations:db.invoices;return (type==='quotation'?'MMP/Q/':'MMP/INV/')+String(new Date().getFullYear())+'/'+String(a.length+1).padStart(4,'0')}
function openDocument(type){document.getElementById('documentForm').reset();document.getElementById('docType').value=type;document.getElementById('documentTitle').textContent=type==='quotation'?'Create Quotation':'Create Invoice';document.getElementById('docNumber').value=nextNumber(type);document.getElementById('docDate').value=new Date().toISOString().slice(0,10);document.getElementById('docReceived').value='0';document.getElementById('docDiscount').value='0';document.getElementById('docGstRate').value='0';document.getElementById('docCustomer').innerHTML='<option value="">Select customer</option>'+db.customers.map(x=>`<option value="${x.id}">${esc(x.name)}</option>`).join('');document.getElementById('docCustomer').onchange=fillCustomer;updateDocTotals();openModal('documentModal')}
function fillCustomer(){const c=db.customers.find(x=>x.id===document.getElementById('docCustomer').value);document.getElementById('docGst').value=c?.gst||'';document.getElementById('docAddress').value=c?.address||''}
['docQty','docRate','docDiscount','docGstRate','docReceived'].forEach(id=>document.getElementById(id).addEventListener('input',updateDocTotals));
function docCalc(){const qty=Number(docQty.value)||0,rate=Number(docRate.value)||0,sub=qty*rate,discount=Math.min(Number(docDiscount.value)||0,sub),taxable=Math.max(0,sub-discount),tax=taxable*(Number(docGstRate.value)||0)/100,total=taxable+tax,received=Number(docReceived.value)||0;return {qty,rate,sub,discount,taxable,tax,total,received,balance:Math.max(0,total-received)}}
function updateDocTotals(){const x=docCalc();docSubtotal.textContent=money(x.sub);docDiscountView.textContent=money(x.discount);docTaxable.textContent=money(x.taxable);docTax.textContent=money(x.tax);docTotal.textContent=money(x.total);docBalance.textContent=money(x.balance)}
document.getElementById('documentForm').addEventListener('submit',e=>{e.preventDefault();const type=docType.value,c=db.customers.find(x=>x.id===docCustomer.value),v=docCalc();if(!c)return toast('Select a customer first.');if(v.total<=0)return toast('Enter a valid quantity and rate.');const x={id:uid(type==='quotation'?'Q':'INV'),number:docNumber.value,date:docDate.value,customerId:c.id,customer:c.name,gst:docGst.value,address:docAddress.value,description:docDescription.value,qty:v.qty,unit:docUnit.value,rate:v.rate,subtotal:v.sub,discount:v.discount,taxable:v.taxable,gstRate:Number(docGstRate.value),tax:v.tax,total:v.total,received:type==='invoice'?v.received:0,balance:type==='invoice'?v.balance:v.total,status:type==='quotation'?'Draft':(v.balance<=0?'Paid':v.received>0?'Partially Paid':'Unpaid'),notes:docNotes.value};(type==='quotation'?db.quotations:db.invoices).push(x);persist();closeModal('documentModal');toast(type==='quotation'?'Quotation saved.':'Invoice saved.')});
function renderDocuments(type){const arr=type==='quotation'?db.quotations:db.invoices,search=(document.getElementById(type==='quotation'?'quoteSearch':'invoiceSearch')?.value||'').toLowerCase(),status=document.getElementById(type==='quotation'?'quoteStatus':'invoiceStatus')?.value||'',filtered=arr.filter(x=>(!status||x.status===status)&&[x.number,x.customer,x.description].join(' ').toLowerCase().includes(search));const target=document.getElementById(type==='quotation'?'quotationRows':'invoiceRows');target.innerHTML=filtered.map(x=>type==='quotation'?`<tr><td><b>${esc(x.number)}</b></td><td>${esc(x.date)}</td><td>${esc(x.customer)}</td><td>${esc(x.description)}<div class="muted">${x.qty} ${esc(x.unit)}</div></td><td><b>${money(x.total)}</b></td><td><span class="pill ${x.status.toLowerCase()}">${esc(x.status)}</span></td><td><button class="btn small" onclick="printDocument('${x.id}','quotation')">Print</button> <button class="btn small danger" onclick="deleteDocument('${x.id}','quotation')">Delete</button></td></tr>`:`<tr><td><b>${esc(x.number)}</b></td><td>${esc(x.date)}</td><td>${esc(x.customer)}</td><td>${money(x.total)}</td><td>${money(x.received)}</td><td><b>${money(x.balance)}</b></td><td><span class="pill ${x.status==='Paid'?'paid':x.status==='Unpaid'?'pending':'partial'}">${esc(x.status)}</span></td><td><button class="btn small" onclick="printDocument('${x.id}','invoice')">Print</button> <button class="btn small danger" onclick="deleteDocument('${x.id}','invoice')">Delete</button></td></tr>`).join('')||`<tr><td colspan="${type==='quotation'?7:8}" class="empty">No ${type}s saved yet.</td></tr>`}
